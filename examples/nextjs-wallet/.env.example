# A Solana RPC endpoint for mainnet. Strongly recommended: the preset's public
# https://api.mainnet-beta.solana.com refuses most requests from browsers.
NEXT_PUBLIC_NIMBUS_RPC=
# The gateway token every session sends to the relayer, guardians, screener, data endorser and fee
# enclave. Next writes it into the page, so every visitor holds it. Empty, an account opens and
# reads, and every flow fails unauthorized. To get one, email dev@umbraprivacy.com or reach out to
# any Umbra team member.
NEXT_PUBLIC_NIMBUS_GATEWAY_TOKEN=
