{
  "name": "nimbus-example-nextjs-wallet",
  "version": "0.0.0",
  "private": true,
  "description": "A Next.js app with private balances on Solana mainnet through @umbra-privacy/nimbus-solana-web: register, deposit, Private Send, withdraw, balances and history.",
  "type": "module",
  "scripts": {
    "assets": "nimbus-solana-web copy-assets public/nimbus",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens": "tsx scripts/fetch-tokens.ts",
    "postinstall": "nimbus-solana-web copy-assets public/nimbus"
  },
  "dependencies": {
    "@solana/kit": "^8.3.0",
    "@umbra-privacy/nimbus-solana-web": "^0.1.1",
    "next": "16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0"
}
